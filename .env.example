# Core
SENTINELZ_ADAPTER=sql
SENTINELZ_MODEL_PATH=./rbac_model.conf
SENTINELZ_MIGRATE_AUTO=true

# SQL adapter
SENTINELZ_SQL_CLIENT=pg
SENTINELZ_DATABASE_URL=postgresql://user:pass@localhost:5432/db
SENTINELZ_SQL_TABLE_NAME=sentinelz_rules
SENTINELZ_SQL_SCHEMA=
SENTINELZ_SQL_CREATE_SCHEMA_IF_MISSING=false

# Mongo adapter
SENTINELZ_MONGODB_URI=mongodb://localhost:27017/sentinelz
SENTINELZ_MONGO_COLLECTION_NAME=sentinelz_rules

# Cache (optional)
SENTINELZ_CACHE_ENABLED=true
SENTINELZ_CACHE_TYPE=redis
SENTINELZ_CACHE_TTL=300
SENTINELZ_REDIS_URL=redis://localhost:6379

# Audit (optional)
SENTINELZ_AUDIT_ENABLED=true

# Multi-tenant (optional)
SENTINELZ_MULTI_TENANT_ENABLED=false
