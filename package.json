{
  "name": "sentinelz",
  "version": "0.1.0",
  "description": "Unified Casbin RBAC/ABAC wrapper with SQL + MongoDB adapters and bundled migrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "casbin",
    "authorization",
    "rbac",
    "abac",
    "nestjs"
  ],
  "license": "MIT",
  "peerDependencies": {
    "casbin": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "casbin": {
      "optional": false
    }
  },
  "optionalDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "knex": "^3.1.0",
    "mongoose": "^8.2.0",
    "mysql2": "^3.9.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "sqlite3": "^5.1.7",
    "tedious": "^18.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "casbin": "^5.30.0",
    "jest": "^29.7.0",
    "knex": "^3.1.0",
    "mongoose": "^8.2.0",
    "mysql2": "^3.9.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/assets && cp src/assets/rbac_model.conf dist/assets/rbac_model.conf",
    "test": "jest",
    "test:adapters": "jest tests/adapters",
    "test:nestjs": "jest tests/nestjs",
    "test:integration": "jest --config jest.integration.config.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm run test"
  }
}
